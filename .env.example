# Copia este archivo a .env y rellena con tus claves reales de Stripe
# Dashboard → Developers → API keys / Webhooks

STRIPE_SECRET_KEY=sk_test_TU_CLAVE_SECRETA
STRIPE_PUBLISHABLE_KEY=pk_test_TU_CLAVE_PUBLICA
STRIPE_WEBHOOK_SECRET=whsec_TU_SECRETO_WEBHOOK

# PostgreSQL
# Docker Compose del proyecto:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tpv_stripe
# DATABASE_SSL=true

PORT=3000
